{
  "mcpServers": {
    "{server-name}": {
      "command": "uvx",
      "args": [
        "--from",
        "{mcp-package}",
        "{mcp-entrypoint}"
      ],
      "env": {
        "DB_CONNECTION_STRING": "{connection-string}",
        "COMMENT_DB_CONNECTION_STRING": "{connection-string}"
      }
    }
  }
}
