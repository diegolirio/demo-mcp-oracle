{
  "mcpServers": {
    "oracle-db": {
      "command": "uvx",
      "args": [
        "--from",
        "oracledb-mcp-server",
        "oracledb_mcp_server"
      ],
      "env": {
        "DB_CONNECTION_STRING": "oracle+oracledb://{db-user}:{db-password}@{db-host}:{db-port}/?service_name={service-name}",
        "COMMENT_DB_CONNECTION_STRING": "oracle+oracledb://{db-user}:{db-password}@{db-host}:{db-port}/?service_name={service-name}"
      }
    }
  }
}
